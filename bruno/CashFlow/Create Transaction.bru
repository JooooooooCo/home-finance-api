meta {
  name: Create Transaction
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/cashflow/transaction
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-Tenant-Id: {{tenantId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "type": "expense",
    "description": "Supermercado",
    "amount": 250.50,
    "payment_type_id": 1,
    "status": "paid",
    "purchase_date": "2024-01-15",
    "due_date": "2024-01-15",
    "payment_date": "2024-01-15",
    "current_installment": 1,
    "total_installments": 1,
    "classification_id": 1,
    "category_id": 1,
    "sub_category_id": null,
    "primary_note": "Compras do mês",
    "secondary_note": null,
    "spending_average": false,
    "is_real": true,
    "is_reconciled": false
  }
}
