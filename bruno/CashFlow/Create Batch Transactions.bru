meta {
  name: Create Batch Transactions
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/cashflow/transaction/batch
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-Tenant-Id: {{tenantId}}
}

auth:bearer {
  token: {{accessToken}}
}

